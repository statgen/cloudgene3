<h2>Mail</h2>

<p>Customize the SMTP mailing system used by Cloudgene to handle outgoing e-mails.</p>

<hr>

<form id="settings-form">

  <div class="form-check">
    <input
      name="mail"
      id="mail"
      value="true"
      type ="checkbox"
      class="form-check-input"
      {{#settings.mail}}checked{{/settings.mail}}
    />
    <label class="form-check-label" for="mail">E-Mail Notifications</label>
    <small class="form-text text-muted">Send users an activation code and notification about their job status.</small>
  </div>

  <div class="mb-3">
    <label for="mail-smtp" {{^settings.mail}}disabled{{/settings.mail}}>Server:</label>
    <div class="row">
      <div class="col-md-4">
        <input
          id="mail-smtp"
          name="mail-smtp"
          type="text"
          class="form-control"
          value="{{settings.mailSmtp}}"
          {{^settings.mail}}disabled{{/settings.mail}}
          autocomplete="off"
        />
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="mail-port" {{^settings.mail}}disabled{{/settings.mail}}>Port:</label>
    <div class="row">
      <div class="col-md-4">
        <input
          id="mail-port"
          name="mail-port"
          type="text"
          class="form-control"
          value="{{settings.mailPort}}"
          {{^settings.mail}}disabled{{/settings.mail}}
          autocomplete="off"
        />
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="mail-user" {{^settings.mail}}disabled{{/settings.mail}}>User:</label>
    <div class="row">
      <div class="col-md-4">
        <input
          id="mail-user"
          name="mail-user"
          type="text"
          class="form-control"
          value="{{settings.mailUser}}"
          {{^settings.mail}}disabled{{/settings.mail}}
          autocomplete="off"
        />
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="mail-password" {{^settings.mail}}disabled{{/settings.mail}}>Password:</label>
    <div class="row">
      <div class="col-md-4">
        <input
          id="mail-password"
          name="mail-password"
          type="password"
          class="form-control"
          value="{{settings.mailPassword}}"
          {{^settings.mail}}disabled{{/settings.mail}}
          autocomplete="off"
        />
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="mail-name" {{^settings.mail}}disabled{{/settings.mail}}>Sender:</label>
    <div class="row">
      <div class="col-md-4">
        <input
          id="mail-name"
          name="mail-name"
          type="text"
          class="form-control col-md-4"
          value="{{settings.mailName}}"
          {{^settings.mail}}disabled{{/settings.mail}}
          autocomplete="off"
        />
      </div>
    </div>
  </div>

  <hr>

  <div class="mb-3">
    <button id="save" class="btn btn-primary" data-loading-text="please wait...">
      <i class="fas fa-save"></i> Save changes
    </button>
  </div>

</form>
