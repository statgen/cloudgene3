<h2>General</h2>

<p>Customize your Cloudgene instance by setting a unique service name and adapating colors.</p>

<hr>

<form id="settings-form">

  <h5>Service</h5>

  <div class="mb-3">
    <label for="name" class="form-label mb-2">Name:</label>
    <div class="row">
      <div class="col-md-4">
        <input id="name" name="name" type="text" class="form-control" value="{{settings.name}}" autocomplete="off">
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="serverUrl" class="form-label mb-2">Server Url:</label>
    <div class="row">
      <div class="col-md-4">
        <input id="serverUrl" name="serverUrl" type="text" class="form-control" value="{{settings.serverUrl}}" autocomplete="off">
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="baseUrl" class="form-label mb-2">Base Url:</label>
    <div class="row">
      <div class="col-md-4">
        <input id="baseUrl" name="baseUrl" type="text" class="form-control" value="{{settings.baseUrl}}" autocomplete="off">
      </div>
    </div>
    <small class="text-muted">has to start with /</small>
  </div>


  <hr/>

  <h5>Contact</h5>

  <div class="mb-3">
    <label for="adminName" class="form-label mb-2">Name:</label>
    <div class="row">
      <div class="col-md-4">
        <input id="adminName" name="adminName" type="text" class="form-control" value="{{settings.adminName}}" autocomplete="off">
      </div>
    </div>
  </div>


  <div class="mb-3">
    <label for="adminMail" class="form-label mb-2">E-Mail:</label>
    <div class="row">
      <div class="col-md-4">
        <input id="adminMail" name="adminMail" type="text" class="form-control" value="{{settings.adminMail}}" autocomplete="off">
      </div>
    </div>
  </div>

  <hr/>

  <h5>Workspace</h5>

  <div class="mb-3">
    <label for="workspaceType" class="form-label mb-2">Type:</label>
    <div class="row">
      <div class="col-md-4">
        <select id="workspaceType" name="workspaceType" type="text" class="form-control" value="{{settings.workspaceType}}" autocomplete="off">
          <option value="local">Local</option>
          <option value="s3">S3</option>
        </select>
      </div>
    </div>
  </div>


  <div class="mb-3">
    <label for="workspaceLocation" class="form-label mb-2">Location:</label>
    <div class="row">
      <div class="col-md-4">
        <input id="workspaceLocation" name="workspaceLocation" type="text" class="form-control" value="{{settings.workspaceLocation}}" autocomplete="off">
      </div>
    </div>
  </div>

  <hr/>

  <h5>Tracking</h5>

  <div class="mb-3">
    <label for="google-analytics" class="form-label mb-2">Google Analytics:</label>
    <div class="row">
      <div class="col-md-4">
        <input id="google-analytics" name="google-analytics" type="text" class="form-control" value="{{settings.googleAnalytics}}" autocomplete="off">
      </div>
    </div>
    <small class="form-text text-muted">Enter your Google Analytics web tracking code (e.g. UA-2110908-2) to activate tracking.</small>
  </div>

  <hr/>

  <div class="mb-3">
    <button id="save" class="btn btn-primary" data-loading-text="please wait...">
      <i class="fas fa-save"></i> Save changes
    </button>
  </div>

</form>
