<form onsubmit="return false;">
  <p>
    Please enter the application repository:
  </p>

  <input class="form-control mb-3" id="url" name="url" placeholder="owner/repository" autocomplete="off"/>

  <p>
    <b>Examples:</b>
    <br>
    lukfor/cg-fetchngs
    <br>
    lukfor/cg-fetchngs@latest
    <br>
    lukfor/hcg-fetchngs@1.0.0
  </p>
</form>
