<div class="mb-5">
  <h2>Applications</h2>
  <p>This page helps you to install applications and to manage permissions.</p>
</div>

<div class="mb-5">
  <div class="btn-group">
    <button id="btnGroupDrop1" type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
      <i class="fas fa-download"></i> Install App
    </button>
    <div class="dropdown-menu" aria-labelledby="btnGroupDrop1">
      <a class="dropdown-item" id="install-app-github-btn" style="cursor: pointer">
        <i class="fab fa-github"></i> from GitHub...
      </a>
      <a class="dropdown-item" id="install-app-url-btn" style="cursor: pointer">
        <i class="fas fa-globe"></i> from URL...
      </a>
    </div>
  </div>
  <div class="btn btn-secondary" id="reload-apps-btn">
    <i class="fas fa-sync-alt"></i> Reload Apps
  </div>
</div>

{{#categories}}
  <div class="mb-5">
    <h4>{{name}}</h4>
    <table class="table table-bordered">
      <thead>
        <tr>
          <th width="400px">Name</th>
          <th width="150px">Version</th>
          <th>Permissions</th>
          <th class="text-end" width="200px">Operations</th>
        </tr>
      </thead>
      <tbody>
        {{#applications}}
          <tr class="{{^enabled}}text-muted{{/enabled}}" {{data 'application'}}>
            <td>
              {{#if workflow}}
                <i class="fas fa-rocket"></i>
                <a href="#!pages/admin-apps/{{id}}">
                  {{name}}
                </a>
              {{else}}
                <i class="fas fa-table"></i>
                {{name}}
              {{/if}}

              <br>

              {{#changed}}
                <small class="text-danger">
                  Warning: File <b>{{filename}}</b> changed on disk. Reload Apps to solve this issue.
                </small>
              {{/changed}}
              {{#errorMessage}}
                <small class="text-danger">{{errorMessage}}</small>
              {{/errorMessage}}
            </td>

            <td>{{version}}</td>

            <td>
              <button type="button" class="edit-permission-btn btn btn-sm btn-outline-secondary">
                <i class="fas fa-users"></i> {{permission}}
              </button>
            </td>

            <td class="text-end">
              {{#if workflow}}
                <a class="btn edit-settings-btn btn btn-sm btn-outline-secondary" href="#!pages/admin-apps/{{id}}" title="go to app settings">
                  <i class="fas fa-cog"></i>
                </a>
              {{/if}}

              <button type="button" class="view-source-btn btn btn-sm btn-outline-secondary" title="view app configuration file">
                <i class="fas fa-code"></i>
              </button>

              <button type="button btn-danger" class="delete-app-btn btn btn-sm btn-outline-secondary" title="delete app">
                <i class="fas fa-trash-alt"></i>
              </button>

              {{#enabled}}
                <button type="button" class="enable-disable-btn btn btn-sm btn-success" title="disable app (currently: running)">
                  <i class="fas fa-pause"></i>
                </button>
              {{else}}
                <button type="button" class="enable-disable-btn btn btn-sm btn-danger" title="enable app (currently: paused)">
                  <i class="fas fa-play"></i>
                </button>
              {{/enabled}}
            </td>
          </tr>
        {{/applications}}
      </tbody>
    </table>
  </div>
{{/categories}}
