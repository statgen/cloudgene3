<div class="mb-4">
  <h2>
    {{application.name}}
    <small class="text-muted fw-light">{{application.id}}</small>
  </h2>
  <a href="#!pages/admin-apps">
    <i class="fas fa-caret-left"></i> Back to Applications
  </a>
</div>

<form>
  <div class="mb-3">
    <p class="mb-0">Profile:</p>
    <p class="mb-0"><small class="text-muted">The profile to be used for pipeline execution (e.g. a nf-core pipeline supports 'docker', 'conda', 'singularity' or 'AWSBATCH').</small></p>
  </div>

  <input
    class="form-control mb-4"
    id="nextflow-profile"
    name="nextflow-profile"
    autocomplete="off"
    value="{{application.config.attr('nextflow.profile')}}"
  />

  <div class="mb-3">
    <p class="mb-0">Working Directory:</p>
    <p class="mb-0"><small class="text-muted">Clougene creates a temporary work directory for each job and deletes it after execution. You can change it or set it to S3 path if you use AWS Batch.</small></p>
  </div>

  <input
    class="form-control mb-4"
    id="nextflow-work"
    name="nextflow-work"
    autocomplete="off"
    value="{{application.config.attr('nextflow.work')}}"
  />

  <div class="mb-3">
    <p class="mb-0">Custom Configuration:</p>
    <p class="mb-0"><small class="text-muted">All app-specific parameters can be set here.</small></p>
  </div>

  <div style=" display: flex; justify-content: center; align-items: flex-start; flex-direction: row;">

    <div style="width: 75%; align-self: stretch;">
      <textarea
        class="form-control mb-4"
        id="nextflow-config"
        name="nextflow-config"
        style="height: 550px; font-size: 14px; font-family: SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;"
      >{{application.config.attr('nextflow.config')}}</textarea>

      <div class="mb-3">
        <p class="mb-0">Custom Environment:</p>
        <p class="mb-0"><small class="text-muted">All app-specific environment variables can be set here.</small></p>
      </div>

      <textarea
        class="form-control mb-4"
        id="nextflow-env"
        name="nextflow-env"
        style="height: 550px; font-size: 14px; font-family: SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;"
      >{{application.config.attr('nextflow.env')}}</textarea>

      <div class="mb-3">
        <button id="save" class="btn btn-primary" data-loading-text="please wait...">
          <i class="fas fa-save"></i> Save changes
        </button>
      </div>
    </div>

    <div style="flex:1">
      <ul>
        {{#application.environment}}
          <li class="mb-2">
            <div>
              <b><code>$&#123;{{name}}&#125;</code></b>
            </div>
            <div>
              <small>Value: {{value}}</small>
            </div>
          </li>
        {{/application.environment}}
      </ul>
    </div>
  </div>
</form>
