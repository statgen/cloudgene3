<div class="mb-4">
  <h2>Users</h2>
  {{^query}}
    <p>
      This page lists all <b>{{users.count}}</b> registered users.
    </p>
  {{/query}}
</div>

<form id="proband-search-form" class="d-inline-flex align-items-center gap-2 mb-3">
  <label for="query" class="form-label mb-0">
    Search:
  </label>
  <div class="input-group">
    <input
      id="query"
      name="query"
      type="text"
      class="form-control"
      value="{{query}}"
      placeholder="username, mail or full name"
      autocomplete="off"
    />
    <button type="submit" class="btn btn-secondary" aria-label="search users">
      <i class="fas fa-search"></i>
    </button>
  </div>
</form>

<table class="table table-striped table-bordered mb-3" id="user-list">
  <thead>
    <tr>
      <th style="width: 16px;">Status</th>
      <th style="width: 150px;">Username</th>
      <th style="width: 200px;">Full Name</th>
      <th>E-Mail</th>
      <th style="width: 200px;">Last Login</th>
      <th style="width: 100px;">Groups</th>
      <th style="width: 16px;">Delete</th>
    </tr>
  </thead>
  <tbody>
    {{#each users }}
      <tr {{data 'user' }}>
        <td class="text-center">
          {{#if lockedUntil }}
            <i class="fas fa-lock" title="account is temporarily locked"></i>
          {{else}}
            {{#if active }}
              <i class="fas fa-check-circle" title="account is active"></i>
            {{else}}
              <i class="fas fa-user-clock" title="account is pending verification"></i>
            {{/if}}
          {{/if}}
        </td>
        <td>
          <a href="#!pages/users/{{username}}" aria-label="User Page">
            {{username}}
          </a>
        </td>
        <td>
          {{fullName}}
        </td>
        <td>
          <small>{{mail}}</small>
        </td>
        <td>
          <small>{{lastLogin}}</small>
        </td>
        <td>
          {{#is(readOnly,false)}}
            <span class="btn btn-sm btn-outline-secondary edit-role-btn ">
              <i class="fas fa-users"></i> {{role}}
            </span>
          {{else}}
            {{role}}
          {{/is}}
        </td>
        <td>
          {{#is(readOnly,false)}}
            <a class="btn btn-sm btn-light delete-user-btn" role="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Delete user">
              <i class="fas fa-trash"></i>
            </a>
          {{/is}}
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

<div class="mx-auto mb-3">
  <ul class="mx-auto pagination">
    <li class="page-item {{^if(users.prev)}}disabled{{/if}}">
      <a class="page-link" href="#!pages/users/pages/{{users.prev}}" aria-label="Previous">
        <span aria-hidden="true">&larr; Previous</span>
      </a>
    </li>
    {{#users.pages}}
      <li class="{{#is(., users.page)}}page-item active{{/is}}">
        <a class="page-link" href="#!pages/users/pages/{{.}}">
          {{.}}
        </a>
      </li>
    {{/users.pages}}
    <li class="page-item {{^if(users.next)}}disabled{{/if}}">
      <a class="page-link" href="#!pages/users/pages/{{users.next}}" aria-label="Next">
        <span aria-hidden="true">Next &rarr;</span>
      </a>
    </li>
  </ul>
</div>
