<h2>Dashboard</h2>

<div class="mb-5">
  <div class="row">
    <div class="alert alert-success p-2 col-md-2 mx-2 text-center">
      <div style="font-size: 40px; width: 100%;" id="new_users">0</div>
      <div style="font-size: 20px; width: 100%;">New Users</div>
    </div>

    <div class="alert alert-info p-2 col-md-2 mx-2 text-center">
      <div style="font-size: 40px; width: 100%;" id="total_users">0</div>
      <div style="font-size: 20px; width: 100%;">Total Users</div>
    </div>


    <div class="alert alert-success p-2 col-md-2 mx-2 text-center">
      <div style="font-size: 40px; width: 100%;" id="new_jobs">0</div>
      <div style="font-size: 20px; width: 100%;">New Jobs</div>
    </div>

    <div class="alert alert-info p-2 col-md-2 mx-2 text-center">
      <div style="font-size: 40px; width: 100%;" id="total_jobs">0</div>
      <div style="font-size: 20px; width: 100%;">Jobs</div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3">
      <select id="day_combo" class="form-select col-md-3">
        <option value="1">Last 24h</option>
        <option value="3">Last 3 days</option>
        <option value="7">Last week</option>
        <option value="14">Last 2 weeks</option>
        <option value="30">Last month</option>
      </select>
    </div>
  </div>

  <div id="morris-area-chart"></div>
</div>

<div class="mb-5">
  <h3>Counters</h3>

  <p>The following counters were submitted by applications.</p>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>Name</th>
        <th style="width: 150px;">Value</th>
      </tr>
    </thead>
    <tbody>
      {{#each counter.complete}}
        <tr>
          <td><b>{{@key}}</b></td>
          <td style="width: 150px;">{{.}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<div class="mb-5">
  <h3>Values</h3>

  <p>The following values were submitted by applications.</p>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>Name</th>
        <th style="width: 150px;">Value</th>
        <th style="width: 150px;">#Jobs</th>
      </tr>
    </thead>
    <tbody>
      {{#each values}}
        <tr>
          <td><b>{{name}}</b></td>
          <td style="width: 250px;">{{value}}</td>
          <td style="width: 150px;">{{count}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
