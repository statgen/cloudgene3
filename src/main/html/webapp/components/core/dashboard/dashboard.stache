      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <a href="https://imputationserver.sph.umich.edu/index.html#!" class="btn btn-primary" role="button">Continue</a>
      </div>
    </div>
  </div>
</div>

