<div class="mb-4">
  <h2>Sign up</h2>
</div>

{{#data.success}}
  <div class="alert alert-success mb-3" id="success-message">
    <b>Well done!</b> Your account is now active. <a href="./">Login now</a>.
  </div>
{{else}}
  <div class="alert alert-danger mb-3" id="success-message">
    <b>Oh snap!</b> {{data.message}}
  </div>
{{/data.success}}
