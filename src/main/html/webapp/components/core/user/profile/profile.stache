<div class="mb-4">
  <h2>Account Settings</h2>
  <p>
    Please fill out the form below to change your account settings or your password.
  </p>
</div>

<form id="account-form" class="form-horizontal">

  <h4>Personal Information</h4>

  <input name="username" type="hidden" value="{{user.username'}}">

  <div class="mb-3">
    <label for="full-name" class="form-label">Full Name:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="full-name" name="full-name" type="text" value="{{user.fullName}}" class="form-control" />
      </div>
    </div>
    <div class="invalid-feedback"></div>
  </div>

  {{#is(anonymousAccount, false)}}

    <div class="mb-3">
      <label for="mail" class="form-label">E-Mail:</label>
      <div class="row">
        <div class="col-sm-3">
          <input id="mail" name="mail" type="text" value="{{user.mail}}" class="form-control" />
        </div>
      </div>
      <div class="invalid-feedback"></div>
    </div>

  {{else}}

    <hr>
    <div class="mb-3">
      <input type="checkbox" id="anonymous" name="anonymous" value="0" {{#emailProvided}}checked{{/emailProvided}}>
      <label for="anonymous" class="form-label">E-Mail Address</label>
      <div class="mb-3" style="margin-left: 30px;">
        <p>
          {{userEmailDescription}}
        </p>
        <label for="mail" class="form-label">E-Mail:</label>
        <div class="row">
          <div class="col-sm-3">
            <input
              id="mail"
              name="mail"
              type="text"
              class="form-control"
              autocomplete="off"
              {{#is(emailProvided, false)}}disabled{{/is}}
              value="{{user.mail}}"
            />
          </div>
        </div>
        <div class="invalid-feedback"></div>
        <br>
        <p>
          {{userWithoutEmailDescription}}
        </p>
      </div>
    </div>

    <hr>

  {{/is}}

  <h4>Change password</h4>

  <div class="mb-3">
    <label for="new-password" class="form-label">New Password:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="new-password" name="new-password" type="password" class="form-control" />
      </div>
    </div>
    <div class="invalid-feedback"></div>
  </div>

  <div class="mb-3">
    <label for="confirm-new-password" class="form-label">New Password (again):</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="confirm-new-password" name="confirm-new-password" type="password" class="form-control" />
      </div>
    </div>
    <div class="invalid-feedback"></div>
  </div>

  <div class="mb-3">
    <button class="btn btn-primary" type="submit">Update Account</button>
  </div>
</form>

<hr class="my-5">

<h3>API Access</h3>

<p>
  This service provides a rich RestAPI to submit, monitor and download jobs.
</p>
<p>
  You need a access token to use the API.
  <a href="https://statgen.github.io/tis-v2-docs/api/api-overview/">Learn more</a>.
</p>

{{#user.hasApiToken}}

  <div class="control-group">
    <div class="controls">
      <button class="btn btn-danger" id="revoke_token">Revoke API Token</button>
    </div>
  </div>

  <small class="{{#is(../user.apiTokenValid, false)}}text-danger{{#is}}">{{../user.apiTokenMessage}}</small>

{{else}}

    <button class="btn btn-primary" id="create_token">Create API Token</button>
    Expires in
    <select  id="token_expiration">
      <option value="30">30 days</option>
      <option value="60">60 days</option>
      <option value="-1">Never</option>
    </select>

{{/user.hasApiToken}}

<hr class="my-5">

<h3>Delete Account</h3>

<p>Once you delete your user account, there is no going back. Please be certain.</p>

<div class="control-group">
  <div class="controls">
    <button class="btn btn-danger" id="delete_account">Delete Account</button>
  </div>
</div>
