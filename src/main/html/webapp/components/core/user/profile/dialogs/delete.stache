<p>
  We will <b>immediately delete all of your jobs, along with all imputed data.</b>
</p>
<p>
  Your username will be available to anyone else on this site.
</p>

<form id="delete-account-form">
  <div class="mb-3">
    <label for="username" class="form-label">Enter your username:</label>
    <div class="controls">
      <input class="form-control" name="username" type="text" data-required="true">
    </div>
  </div>

  <div class="mb-3">
    <label for="password" class="form-label">Enter your password:</label>
    <div class="controls">
      <input class="form-control" name="password" type="password">
    </div>
  </div>
</form>
