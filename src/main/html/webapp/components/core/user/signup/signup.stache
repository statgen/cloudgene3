<h2 class="mb-4">Sign up</h2>

<div class="alert alert-success d-none" id="success-message">
</div>

<form id="signon-form" class="form-horizontal needs-validation" autocomplete="off">

  <div class="mb-3">
    <label for="username" class="form-label">Username:</label>
    <div class="row">
      <div class="col-sm-3">
        <input
          id="username"
          name="username"
          type="text"
          class="form-control"
          data-required="true"
          pattern="[a-zA-Z0-9_]+"
          title="Usernames are at least 4 characters long. They can only contain letters, underscores, and numbers."
          autocomplete="off"
          pattern="[a-z][a-z0-9_]+[a-z0-9]"
          minlength="4"
          maxlength="16"
          aria-describedby="username-feedback"
          required
        />
        <div id="username-feedback" class="invalid-feedback"></div>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="full-name" class="form-label">Full Name:</label>
    <div class="row">
      <div class="col-sm-3">
        <input
          id="full-name"
          name="full-name"
          type="text"
          class="form-control"
          autocomplete="off"
          pattern="\w(\w|\s)*\w"
          title="Your full legal name (at least two characters)"
          aria-describedby="full-name-feedback"
          required
        />
        <div id="full-name-feedback" class="invalid-feedback"></div>
      </div>
    </div>
  </div>

  {{#is(emailRequired, true)}}

    <div class="mb-3">
      <label for="mail" class="form-label">E-Mail:</label>
      <div class="row">
        <div class="col-sm-3">
          <input
            id="mail"
            name="mail"
            type="email"
            class="form-control"
            autocomplete="off"
            required
          />
          <div id="mail-feedback" class="invalid-feedback"></div>
        </div>
      </div>
    </div>

  {{else}}
    <hr>

    <div class="mb-3">
      <!-- Radio button + email field: I want to give an address (gets validated) -->
      <input type="radio" id="optional-mail-accept" name="anonymous" value="0" checked>
      <label for="optional-mail-accept" class="form-label">I will provide an E-Mail Address</label>
      <div class="mb-3 ms-3">
        <p>
          {{{userEmailDescription}}}
        </p>
        <label for="mail" class="form-label">E-Mail:</label>
        <div class="row">
          <div class="col-sm-3">
            <input
              id="mail"
              name="mail"
              type="email"
              class="form-control"
              autocomplete="off"
            />
            <div id="mail-feedback" class="invalid-feedback"></div>
          </div>
        </div>
      </div>

      <!-- Only radio button: I don't want to give an address (no validation) -->
      <input type="radio" id="optional-mail-reject" name="anonymous" value="1">
      <label for="optional-mail-reject" class="form-label">I don't want to provide an E-Mail address</label>
      <div class="mb-3 ms-3">
        <p>
          {{{userWithoutEmailDescription}}}
        </p>
      </div>
    </div>

    <hr>
  {{/is}}

  <div class="mb-3">
    <label for="password" class="form-label">Password:</label>
    <div class="row">
      <div class="col-sm-3">
        <input
          id="password"
          name="password"
          type="password"
          class="form-control"
          data-required="true"
          title="Passwords are at least 6 characters long. They contain letters, numbers, and special characters."
          autocomplete="off"
          minlength="14"
          required
        />
        <div id="password-feedback" class="invalid-feedback"></div>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="confirm-password" class="form-label">Confirm password:</label>
    <div class="row">
      <div class="col-sm-3">
        <input
          id="confirm-password"
          name="confirm-password"
          type="password"
          class="form-control"
          data-required="true"
          title="Confirm your new password."
          autocomplete="off"
          minlength="6"
          required
        />
        <div id="confirm-password-feedback" class="invalid-feedback"></div>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <button id="save" class="btn btn-primary" data-loading-text="please wait..." type="submit">Register</button>
  </div>

</form>
