<h2 class="mb-4">Sign up</h2>

<div class="alert alert-success d-none" id="success-message">
</div>

<form id="signon-form" class="form-horizontal" autocomplete="off">

  <div class="mb-3">
    <label for="username" class="form-label">Username:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="username" name="username" type="text" class="form-control" autocomplete="off">
      </div>
    </div>
    <div class="invalid-feedback"></div>
  </div>

  <div class="mb-3">
    <label for="full-name" class="form-label">Full Name:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="full-name" name="full-name" type="text" class="form-control" autocomplete="off">
      </div>
    </div>
    <div class="invalid-feedback"></div>
  </div>

  {{#is(emailRequired, true)}}

    <div class="mb-3">
      <label for="mail" class="form-label">E-Mail:</label>
      <div class="row">
        <div class="col-sm-3">
          <input id="mail" name="mail" type="text" class="form-control" autocomplete="off">
        </div>
      </div>
      <div class="invalid-feedback"></div>
    </div>

  {{else}}
    <hr>

    <div class="mb-3">
      <input type="radio" id="anonymous1" name="anonymous" value="0" checked>
      <label for="anonymous1" class="form-label">E-Mail Address</label>
      <div class="mb-3" style="margin-left: 30px;">
        <p>
          {{{userEmailDescription}}}
        </p>
        <label for="mail" class="form-label">E-Mail:</label>
        <div class="row">
          <div class="col-sm-3">
            <input id="mail" name="mail" type="text" class="form-control" autocomplete="off">
          </div>
        </div>
        <div class="invalid-feedback"></div>
      </div>
      <input type="radio" id="anonymous2" name="anonymous" value="1"> <label for="anonymous2" class="form-label">I don't want to provide my email address</label>
      <div class="mb-3" style="margin-left: 30px;">
        <p>
          {{{userWithoutEmailDescription}}}
        </p>
      </div>
    </div>

    <hr>
  {{/is}}

  <div class="mb-3">
    <label for="new-password" class="form-label">Password:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="new-password" name="new-password" type="password" class="form-control" autocomplete="off">
      </div>
    </div>
    <div class="invalid-feedback"></div>
  </div>

  <div class="mb-3">
    <label for="confirm-new-password" class="form-label">Confirm password:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="confirm-new-password" name="confirm-new-password" type="password" class="form-control" autocomplete="off">
      </div>
    </div>
    <div class="invalid-feedback"></div>
  </div>

  <div class="mb-3">
    <button id="save" class="btn btn-primary" data-loading-text="please wait...">Register</button>
  </div>

</form>
