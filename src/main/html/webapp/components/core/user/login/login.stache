<h2>Sign in</h2>
<br>

<form id="signin-form" autocomplete="off">

  <div class="mb-3">
    <label for="username" class="form-label mb-2">Username:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="username" name="username" type="text" class="form-control" data-required="true" autocomplete="off" />
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label for="password" class="form-label mb-2">Password:</label>
    <div class="row">
      <div class="col-sm-3">
        <input id="password" name="password" type="password" class="form-control" autocomplete="off" >
        <div class="invalid-feedback" id="invalid-password">
          This parameter is required.
        </div>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <button class="btn  btn-primary" type="submit">Sign in</button>
  </div>
</form>

<hr>

<p>or sign in with: </p>

<ul>
  {{#oauth}}
    <li><a href="/oauth/login/{{.}}">{{.}}</a></li>
  {{/oauth}}
</ul>


<br>
<p>New user? <a href="#!pages/register">Sign up for free</a></p>
<p>Forgotten your password? <a href="#!pages/reset-password">Reset your password</a></p>
