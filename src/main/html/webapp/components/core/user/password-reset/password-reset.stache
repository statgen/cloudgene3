<div class="mb-4">
  <h2>Reset your Password</h2>
  <p>
    Enter your username or email address, and we will send recovery instructions to your email address.
  </p>
</div>

<div class="alert alert-success d-none" id="success-message">
</div>

<div id="reset-page">
  <form class="form-horizontal" id="reset-form">
    <div class="mb-3">
      <label for="username" class="form-label">Username or Email:</label>
      <div class="row">
        <div class="col-sm-3">
          <input name="username" type="text" class="form-control" />
        </div>
      </div>
      <div class="invalid-feedback"></div>
    </div>
    <div class="mb-3">
      <button class="btn  btn-primary" type="submit">Get New Password</button>
    </div>
  </form>
</div>
