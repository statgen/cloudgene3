<div class="mb-4">
  <h2>Reset Password</h2>
  <p>
    Please fill out the form below to change the password for user <b>{{user}}</b>.
  </p>
</div>

<div class="alert alert-danger d-none" id="error-message"></div>

<div class="alert alert-success d-none" id="success-message"></div>

<div id="update-page">
  <form id="update-password-form" class="form-horizontal" autocomplete="off">

    <input name="token" type="hidden" value="{{key}}" hidden="true">
    <input name="username" type="hidden" value="{{user}}" hidden="true">

    <div class="mb-3">
      <label for="full-name" class="form-label">
        New Password:
      </label>
      <div class="row">
        <div class="col-sm-3">
          <input name="new-password" type="password" autocomplete="off" class="form-control" />
        </div>
      </div>
    </div>

    <div class="mb-3">
      <label for="full-name" class="form-label">
        New Password (again):
      </label>
      <div class="row">
        <div class="col-sm-3">
          <input name="confirm-new-password" type="password" autocomplete="off" class="form-control" />
          <div class="invalid-feedback"></div>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <button class="btn btn-primary" type="submit">
        Update Account
      </button>
    </div>

  </form>
</div>
