<div id="myTabContent" class="tab-content">
  <div class="tab-pane active in" id="links">
    <textarea class="form-control form-control-sm code-font" id="message" rows="3">{{hostname}}/share/results/{{output.hash}}/{{output.name}}</textarea>
  </div>
  <div class="tab-pane" id="wget">
    <textarea class="form-control form-control-sm code-font" id="message" rows="3">wget {{hostname}}/share/results/{{output.hash}}/{{output.name}}</textarea>
  </div>
</div>
