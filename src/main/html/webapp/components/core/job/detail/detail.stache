<div class="page-header">
  <div class="py-1 container">
    <div class="job-header d-flex justify-content-start align-items-center">

      <span class="status badge bg-{{job.stateAsClass}}"><i class="{{job.stateAsImage}}"></i></span>

      <div>
        <h2>{{job.longName}}</h2>
        <small class="text-muted">
          <span class="me-2">
            <i class="fas fa-clock"></i> {{prettyDate(job.submittedOn}}
          </span>
          <span class="me-2">
            <i class="fas fa-hourglass"></i> {{prettyTime(job.executionTime)}}
          </span>
          <span class="me-2">
            <i class="fas fa-user"></i>
            {{#is(admin, true)}}
              <a href="#!pages/users/{{job.username}}" aria-label="User Page">
                {{job.username}}
              </a>
            {{else}}
              {{job.username}}
            {{/is}}
          </span>
          <span class="me-2">
            <i class="fas fa-tag"></i> {{job.application}}
          </span>
        </small>
      </div>

      <div class="ms-auto">
        {{#is(admin, true)}}
          {{#is(job.isPending, true)}}
            <a id="restart-btn" class="btn btn-light" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Restart job"><i class="fas fa-undo"></i></a>
          {{/is}}
        {{/is}}
        {{#job.canCancel}}
          <a id="cancel-btn" class="btn btn-light" role="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Cancel job"><i class="fas fa-times"></i></a>
        {{/job.canCancel}}
        {{#job.canDelete}}
          <a id="delete-btn" class="btn btn-light" role="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Delete job"><i class="fas fa-trash"></i></a>
        {{/job.canDelete}}
      </div>
    </div>

    {{#is(job.isInQueue, true)}}
      <br>
      <div class="alert alert-info">
        Job is in queue on position <b>{{job.positionInQueue}}</b>.
      </div>
    {{/is}}

    {{#is(job.public, true)}}
      <br>
      <div class="alert alert-info">
        Please bookmark this page to monitor your job and to download your results!
      </div>
    {{/is}}

    {{#is(job.willBeRetired, true)}}
      <br>
      <div class="alert alert-info">
        Your job retires on <b>{{prettyDate(job.deletedOn)}}</b>! All results will be deleted at that time. Please ensure that you have downloaded all data.
      </div>
    {{/is}}

  </div>
</div>

{{^is(tab,'')}}
  <div class="full-container" style="border-bottom: 1px solid #dee2e6" >
    <div class="container">
      <ul class="nav nav-tabs" style="border-bottom: 0px">

        <li class="nav-item">
          <a class="nav-link {{#is(tab, 'steps')}}active{{/is}}" href="#!jobs/{{job.id}}">
            Details
          </a>
        </li>

        {{#is(job.isRetired, false)}}
          <li class="nav-item">
            <a class="nav-link {{#is(tab, 'results')}}active{{/is}}" href="#!jobs/{{job.id}}/results">
              Results
            </a>
          </li>
        {{/is}}

        {{#job.canShowLog}}
        <li class="nav-item">
          <a class="nav-link {{#is(tab, 'logs')}}active{{/is}}" href="#!jobs/{{job.id}}/logs">
            Logs
          </a>
        </li>
        {{/job.canShowLog}}

      </ul>

      <script type="text/javascript">
        function resizeIframe(iframe) {
          height = iframe.contentWindow.document.body.scrollHeight + 10 + 10;
          if (height < 480) {
            height = 480;
          }
          iframe.height = height + "px";
        }
      </script>
    </div>
  </div>

  <div class="py-4 full-container"  style="background: #fff">
    <div class="container">

      {{#is(job.isPending, true)}}
        <br>
        <p>
          <i>This job is pending. We will start your job as soon as possible!</i>
        </p>
      {{/is}}

      {{#is(job.isRetired, true)}}
        <br>
        <p>
          <i>This job is too old and retired. All results are deleted.</i>
        </p>
      {{/is}}

      <br>

      {{#is(tab, 'steps')}}
        <div class="tab-pane active" id="tab-steps"></div>
      {{/is}}

      {{#is(job.isRetired, false)}}
        {{#is(tab, 'results')}}
          <div class="tab-pane active" id="tab-results"></div>
        {{/is}}
      {{/is}}

      {{#is(tab, 'logs')}}
        <div class="tab-pane active log-pane" id="tab-logs"></div>
      {{/is}}

    </div>
  </div>
{{/is}}
