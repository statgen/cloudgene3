    "can-connect": "1.5.18",
    "can-control": "3.2.4",
    "can-deparam": "1.0.3",
    "can-list": "3.2.2",
    "can-map": "3.4.2",
    "can-map-define": "3.1.2",
    "can-route": "3.3.4",
    "can-stache": "3.14.22",
    "can-util": "3.12.0",
    "dateformat": "3.0.3",
    "jquery": "3.7.1",
    "jquery-form": "3.50.0",
    "md5": "2.2.1",
    "morris.js": "0.5.0",
