      "jquery/jquery": "jquery/dist/jquery"
    },
    "meta": {
      "raphael": {
        "format": "global",
        "exports": "Raphael"
      },
      "jquery": {
        "format": "global"
      }
    },
    "envs": {
      "window-production": {
        "bundlesPath": "bundles"
