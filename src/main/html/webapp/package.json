  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run lint && node build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "steal-css": "^1.3.2",
    "steal-less": "^1.3.1",
    "steal-stache": "3.1.3",
    "steal-tools": "^2.3.0"
